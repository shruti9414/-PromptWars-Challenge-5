# Copy this file to .env.local (never commit .env.local). Without a key the app runs in clearly labelled demo mode.
# Fill in ONE provider. Keys are read on the server only and never sent to the browser.

# Anthropic (key starts with sk-ant-):
ANTHROPIC_API_KEY=
# OpenAI (key starts with sk-):
OPENAI_API_KEY=
# DeepSeek:
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Optional: pick the provider when several keys are set ("anthropic", "openai" or "deepseek").
# Without it the first configured one is used, in that order.
# AI_PROVIDER=deepseek
# Optional: override the model for any provider. Defaults: claude-sonnet-5-5, gpt-4.1, deepseek-chat.
# AI_MODEL=
